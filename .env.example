NEXT_PUBLIC_AMAZON_US=diajemgroup-20
NEXT_PUBLIC_AMAZON_ES=diajemgroup00-21
NEXT_PUBLIC_AMAZON_DE=diajemgroup0c-21
NEXT_PUBLIC_AMAZON_FR=diajemgroup0a-21
NEXT_PUBLIC_AMAZON_IT=diajemgroup04-21

# ============================================
