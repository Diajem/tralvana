# ============================================
# TREVANA - Environment Variables
# ============================================
# Copy this to .env.local and fill in values
# NEVER commit .env.local to git

NEXT_PUBLIC_SITE_NAME=Tralvana
NEXT_PUBLIC_SITE_URL=https://tralvana.com
NEXT_PUBLIC_SITE_TAGLINE=Your World Starts Here

# ============================================
# AMAZON ASSOCIATES - Multi-region
# ============================================
